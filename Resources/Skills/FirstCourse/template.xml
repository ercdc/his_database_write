<?xml version="1.0" encoding="UTF-8"?>
<首次病程记录>
  <医院名称>{{医院名称}}</医院名称>
  <患者信息>
    <姓名>{{姓名}}</姓名>
    <性别>{{性别}}</性别>
    <年龄>{{年龄整数}}</年龄>
    <病区>{{病区}}</病区>
    <床号>{{床号}}</床号>
    <住院号>{{住院号}}</住院号>
    <ID号>{{患者ID}}</ID号>
  </患者信息>
  <记录时间>{{带时区的ISO8601时间}}</记录时间>
  <病例特点>
    <临床表现>
      <发病及病程>{{发病及病程}}</发病及病程>
      <主要症状>{{主要症状}}</主要症状>
      <既往史>{{既往史}}</既往史>
      <查体>{{查体}}</查体>
    </临床表现>
    <辅助资料>
      <检查项目>
        <项目名称>{{检查项目名称}}</项目名称>
        <结果>{{检查结果}}</结果>
      </检查项目>
    </辅助资料>
  </病例特点>
  <拟诊讨论>
    <诊断依据>{{诊断依据}}</诊断依据>
    <鉴别诊断>{{鉴别诊断}}</鉴别诊断>
    <入院诊断>
      <诊断>{{入院诊断}}</诊断>
    </入院诊断>
  </拟诊讨论>
  <病例分型>{{病例分型，可省略整个节点}}</病例分型>
  <诊疗计划>
    <计划>
      <序号>1</序号>
      <内容>{{诊疗计划}}</内容>
    </计划>
  </诊疗计划>
  <医师信息>
    <带组医师>{{带组医师}}</带组医师>
    <书写医师>{{书写医师}}</书写医师>
  </医师信息>
</首次病程记录>
